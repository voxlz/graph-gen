import "../scopes/bookstore_scope.ggn"

title "Bookstore - UC2 - Track a shipment"

edges {
    customer --> gateway: "GET /orders/{id}/tracking {cookie:auth}"
    gateway --> orders: "get order {id}"
    orders --> postgres: "READ {order, shipment ref}"
    orders --> shipping: "GET tracking {shipment ref}"
    shipping --> orders: "Return {status, ETA}"

    // comment
    orders --> gateway: "Return {tracking}"
    gateway --> customer: "Return {status + ETA}"
}
