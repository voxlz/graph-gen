import "../scopes/weather_scope.ggn"

title "Weather API - UC1 - Fetch current conditions"

graph {
    nodeGap 150
}

edges {
    client --> api: "GET /current {lat, lon, apikey}"
    api --> cache: "READ {recent reading}"
    api --> noaa: "GET observations {station}"
    noaa --> api: "Return {raw observations}"
    api --> tsdb: "WRITE {normalized reading}"
    api --> cache: "WRITE {cache reading, ttl:300}"
    api --> client: "Return {temperature, wind, humidity}"
}
