import "../scopes/bookstore_scope.ggn"

title "Bookstore - UC1 - Browse and place an order"

graph {
    nodeGap 150
}

edges {
    customer --> gateway: "GET /books {query}"
    gateway --> catalog: "search {query}"
    catalog --> cache: "READ {cached results}"
    catalog --> postgres: "READ {book records}"
    catalog --> gateway: "Return {books}"
    gateway --> customer: "Return {book list}"
    customer --> gateway: "POST /orders {cart, cookie:auth}"
    gateway --> orders: "create order {cart}"
    orders --> postgres: "WRITE {order}"
    orders --> payments: "charge {amount, token}"
    orders --> email: "SEND {order confirmation}"
    orders --> customer: "Return {order id}"
}
