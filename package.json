{
  "name": "@voxlz/graph-gen",
  "version": "4.5.4",
  "description": "Constraint-based graph layout -> PNG renderer",
  "main": "dist/index.js",
  "bin": {
    "graph-gen": "dist/index.js",
    "graphgen": "dist/index.js"
  },
  "files": [
    "dist/index.js",
    "style.jsonc"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/voxlz/graph-gen.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsx src/bundle.ts",
    "prepack": "npm run build",
    "generate": "tsx src/generate.ts",
    "render-all": "tsx src/render-all.ts",
    "render-frames": "tsx src/render-frames.ts",
    "watch": "tsx src/watch.ts . renders",
    "verify": "tsx src/verify.ts",
    "benchmark": "tsx src/benchmark.ts",
    "render-strategies": "tsx tests/strategies/render-series.ts",
    "test": "jest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "canvas": "^3.2.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/webcola": "^3.1.27",
    "esbuild": "^0.28.2",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "webcola": "^3.4.0"
  }
}
