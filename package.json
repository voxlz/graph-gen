{
  "name": "graphgen",
  "version": "3.0.5",
  "description": "Constraint-based graph layout -> PNG renderer",
  "main": "src/index.ts",
  "type": "commonjs",
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsx src/bundle.ts",
    "generate": "tsx src/generate.ts",
    "render-all": "tsx src/render-all.ts",
    "render-frames": "tsx src/render-frames.ts",
    "watch": "tsx src/watch.ts . renders",
    "verify": "tsx src/verify.ts",
    "benchmark": "tsx src/benchmark.ts",
    "render-strategies": "tsx tests/strategies/render-series.ts",
    "test": "jest",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "canvas": "^3.2.3",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.1",
    "webcola": "^3.4.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/webcola": "^3.1.27",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
